{
  "name": "@nigako/payments-client",
  "version": "0.3.0",
  "description": "Nigako Payments — provider-agnostic payment gateway (payIn/payOut/getStatus/verifyWebhook) + legacy PaiementPro pay-in. Stateless, framework-agnostic. XOF.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "gateway": [
        "./dist/gateway/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "default": "./dist/gateway/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "GATEWAY.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nigako/nigako-payments-node-sdk.git",
    "directory": "packages/payments-client"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run clean && npm run build"
  }
}
