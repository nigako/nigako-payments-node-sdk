{
  "name": "@nigako/payments-client",
  "version": "0.2.0",
  "description": "Nigako Payments — PaiementPro pay-in init + self-signed callback-token signing/verification. Stateless, framework-agnostic. XOF.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nigako/nigako-payments-node-sdk.git",
    "directory": "packages/payments-client"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run clean && npm run build"
  }
}
